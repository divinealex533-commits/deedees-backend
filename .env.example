# Copy this file to ".env" and fill in real values before deploying

# Change this to a long random string — keeps login sessions secure
JWT_SECRET=change-this-to-a-long-random-string

PORT=3001

# From your Paystack dashboard: Settings -> API Keys & Webhooks
# Use the "test" keys while developing, "live" keys once you're ready for real payments
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Where Paystack sends the customer back after they pay
# (a page on your frontend, e.g. your dashboard page)
PAYSTACK_CALLBACK_URL=http://localhost:5500/dashboard.html
